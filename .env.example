# ESOL Scripts – copy to .env and fill in

# Backend (FastAPI)
# TTS_PROVIDER can be:
#   - openai     (requires OPENAI_API_KEY)
#   - elevenlabs (requires ELEVENLABS_API_KEY, natural voices)
#   - local      (macOS `say` only, no API key)
TTS_PROVIDER=elevenlabs
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional second account (UI profile "Elizabeth")
ELEVENLABS_API_KEY_ELIZABETH=

# Frontend (Next.js) – optional; defaults to http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
